<Window x:Class="ProcessVault.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ProcessVault" Width="1300" Height="850" MinWidth="1020" MinHeight="650" Background="{StaticResource CanvasBrush}" Closing="Window_Closing">
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="190"/></Grid.RowDefinitions>
<Grid Grid.Row="0" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ProcessVault" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Local application and process testing panel" Foreground="{StaticResource MutedBrush}" FontSize="12"/></StackPanel><Border Grid.Column="1" Background="#FBEBD8" CornerRadius="4" Padding="11,7" VerticalAlignment="Center"><TextBlock Text="HOST EXECUTION - NOT ISOLATED" FontSize="11" FontWeight="Bold" Foreground="#8A4D0C"/></Border></Grid>
<Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="Program" FontSize="11" Foreground="{StaticResource MutedBrush}"/><DockPanel><Button Content="Browse" DockPanel.Dock="Right" Click="Browse_Click"/><TextBox x:Name="ProgramPathBox" Padding="8" BorderBrush="{StaticResource LineBrush}"/></DockPanel><TextBox x:Name="ArgumentsBox" Padding="8" BorderBrush="{StaticResource LineBrush}" Margin="0,6,0,0" ToolTip="Optional arguments"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Website (HTTP or HTTPS)" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="WebsiteBox" Text="https://" Padding="8" BorderBrush="{StaticResource LineBrush}"/><TextBlock Text="Opens in default browser and uses its current profile." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Bottom"><Button Content="Run program" Click="Run_Click"/><Button Content="Open website" Click="Website_Click"/><Button Content="Stop launched program" Click="Stop_Click" Margin="0"/></StackPanel></Grid></Border>
<Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="305"/></Grid.ColumnDefinitions><Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,8"><StackPanel><TextBlock Text="Process explorer" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="ProcessCount" Text="Reading host process inventory..." FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBox x:Name="SearchBox" Width="170" Padding="6" Margin="0,0,6,0" TextChanged="SearchChanged"/><Button Content="Refresh" Click="Refresh_Click" Margin="0"/></StackPanel></DockPanel><DataGrid x:Name="ProcessGrid" Grid.Row="1" ItemsSource="{Binding Processes}" SelectionChanged="ProcessSelected"><DataGrid.Columns><DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70"/><DataGridTextColumn Header="Parent" Binding="{Binding ParentLabel}" Width="75"/><DataGridTextColumn Header="RAM" Binding="{Binding MemoryLabel}" Width="85"/><DataGridTextColumn Header="CPU" Binding="{Binding CpuLabel}" Width="75"/></DataGrid.Columns></DataGrid></Grid></Border>
<StackPanel Grid.Column="1"><GroupBox Header="Selected process"><StackPanel><TextBlock x:Name="SelectedName" Text="Choose a process" FontWeight="SemiBold"/><TextBlock x:Name="SelectedDetails" Text="Read-only observation; process path may require permissions." TextWrapping="Wrap" Margin="0,5,0,8"/><Button Content="Observe selected (read-only)" Click="Observe_Click" Margin="0"/></StackPanel></GroupBox><GroupBox Header="Test session"><StackPanel><TextBlock x:Name="SessionState" Text="Ready" FontWeight="SemiBold"/><TextBlock x:Name="SessionTarget" Text="No target" Margin="0,4,0,7" TextWrapping="Wrap"/><TextBlock x:Name="HashText" Text="Program SHA-256 appears here" FontSize="10" TextWrapping="Wrap"/><Button Content="Export JSON report" Click="Export_Click" Margin="0,8,0,0"/></StackPanel></GroupBox><TextBlock Text="Host process CPU and RAM are sampled. System-wide file and network activity are not monitored." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel></Grid>
<Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="11"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,6"><TextBlock Text="Test activity" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="EventCount" DockPanel.Dock="Right" Text="Host-observed" Foreground="{StaticResource MutedBrush}" FontSize="11"/></DockPanel><ListView Grid.Row="1" ItemsSource="{Binding Events}" BorderThickness="0" FontSize="12"><ListView.View><GridView><GridViewColumn Header="Time" Width="85" DisplayMemberBinding="{Binding Time}"/><GridViewColumn Header="Type" Width="95" DisplayMemberBinding="{Binding Type}"/><GridViewColumn Header="Activity / output" Width="970" DisplayMemberBinding="{Binding Message}"/></GridView></ListView.View></ListView></Grid></Border>
<Border x:Name="Warning" Grid.RowSpan="4" Background="#C919272C" Visibility="Collapsed"><Border Background="White" CornerRadius="7" Padding="24" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="Runs directly on this PC" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="ProcessVault is a monitoring panel, not a sandbox. A selected program receives your normal account permissions and can access host files, devices, credentials and network. Websites use your current browser profile. Continue only with software and sites you trust." TextWrapping="Wrap" Margin="0,12,0,18"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="Cancel_Click"/><Button Content="I understand - continue" Click="Confirm_Click" Margin="0"/></StackPanel></StackPanel></Border></Border>
</Grid></Window>
