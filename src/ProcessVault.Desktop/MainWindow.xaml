<Window x:Class="ProcessVault.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Space Tester"
        Icon="pack://application:,,,/Assets/S.ico"
        Width="1300" Height="850" MinWidth="1020" MinHeight="480"
        Background="{DynamicResource CanvasBrush}"
        AllowDrop="True" DragEnter="Window_DragEnter" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent" CanContentScroll="False">
        <Grid Margin="20" MinWidth="960">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="190" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Menu Background="Transparent" Padding="0" Margin="0,0,0,4">
                    <MenuItem Header="_File">
                        <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Click="Open_Click" />
                        <Separator />
                        <MenuItem Header="E_xit" Click="Exit_Click" />
                    </MenuItem>
                </Menu>
                <TextBlock Text="Space Tester" FontSize="23" FontWeight="SemiBold" />
                <TextBlock Text="Educational app isolation and process explorer"
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource AccentSurfaceBrush}"
                    CornerRadius="4" Padding="11,7" VerticalAlignment="Center">
                <TextBlock Text="APPCONTAINER ISOLATION" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource AccentInkBrush}" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Program" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                    <DockPanel>
                        <Button Content="Browse" DockPanel.Dock="Right" Click="Browse_Click" />
                        <TextBox x:Name="ProgramPathBox" Padding="8" />
                    </DockPanel>
                    <TextBox x:Name="ArgumentsBox" Padding="8" Margin="0,6,0,0"
                             ToolTip="Optional arguments" />
                    <TextBlock Text="Drop a .exe anywhere in this window, or use File &gt; Open..."
                               FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="2,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="Website (HTTP or HTTPS)" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}" />
                    <TextBox x:Name="WebsiteBox" Text="https://" Padding="8" />
                    <TextBlock Text="Edge runs with internet access, without your normal browser profile."
                               FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <Button Content="Isolate program" Click="Run_Click" />
                    <Button Content="Isolate website" Click="Website_Click" />
                    <Button Content="Stop isolated process" Click="Stop_Click" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12" MinHeight="340">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="305" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Process explorer" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="ProcessCount" Text="Reading host process inventory..."
                                       FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <TextBox x:Name="SearchBox" Width="170" Padding="6"
                                     Margin="0,0,6,0" TextChanged="SearchChanged" />
                            <Button Content="Refresh" Click="Refresh_Click" Margin="0" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="ProcessGrid" Grid.Row="1" ItemsSource="{Binding Processes}"
                              SelectionChanged="ProcessSelected" AlternationCount="2" MaxHeight="360"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" />
                            <DataGridTextColumn Header="Parent" Binding="{Binding ParentLabel}" Width="75" />
                            <DataGridTextColumn Header="RAM" Binding="{Binding MemoryLabel}" Width="85" />
                            <DataGridTextColumn Header="CPU" Binding="{Binding CpuLabel}" Width="75" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1">
                <GroupBox Header="Selected process">
                    <StackPanel>
                        <TextBlock x:Name="SelectedName" Text="Choose a process" FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectedDetails"
                                   Text="Read-only observation; process path may require permissions."
                                   TextWrapping="Wrap" Margin="0,5,0,8" />
                        <Button Content="Observe selected (read-only)" Click="Observe_Click" Margin="0" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Test session">
                    <StackPanel>
                        <TextBlock x:Name="SessionState" Text="Ready" FontWeight="SemiBold" />
                        <TextBlock x:Name="SessionTarget" Text="No target" Margin="0,4,0,7"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="HashText" Text="Program SHA-256 appears here"
                                   FontSize="10" TextWrapping="Wrap" />
                        <Button Content="Export JSON report" Click="Export_Click" Margin="0,8,0,0" />
                    </StackPanel>
                </GroupBox>
                <TextBlock Text="Host process CPU and RAM are sampled. System-wide file and network activity are not monitored."
                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="6" Padding="11">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Test activity" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock x:Name="EventCount" DockPanel.Dock="Right" Text="Host-observed"
                               Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                </DockPanel>
                <ListView Grid.Row="1" ItemsSource="{Binding Events}" BorderThickness="0" FontSize="12"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Time" Width="85" DisplayMemberBinding="{Binding Time}" />
                            <GridViewColumn Header="Type" Width="95" DisplayMemberBinding="{Binding Type}" />
                            <GridViewColumn Header="Activity / output" Width="970" DisplayMemberBinding="{Binding Message}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        </Grid>
        </ScrollViewer>
        <Border x:Name="Warning" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="7" Padding="24"
                    Width="480" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="WarningTitle" Text="Run in AppContainer"
                               FontSize="21" FontWeight="SemiBold" />
                    <TextBlock x:Name="WarningBody"
                               Text="Space Tester applies Windows AppContainer process restrictions. This educational isolation tool is not a VM and is not suitable for serious malware."
                               TextWrapping="Wrap" Margin="0,12,0,18" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="Cancel_Click" />
                        <Button x:Name="ConfirmButton" Content="Launch isolated process"
                                Click="Confirm_Click" Margin="0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
